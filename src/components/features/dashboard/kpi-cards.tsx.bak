/**
 * A minimal sparkline area chart styled like the npm download graph.
 * Uses recharts (already in the project) instead of MUI x-charts.
 */
function Sparkline({ data }: { data: { value: number }[] }) {
  const values = data.map((d) => d.value);
  const min = Math.min(...values);
  const max = Math.max(...values);
  const pad = (max - min) * 0.15 || 1; // small padding so the line doesn't touch the edge

  return (
    <div className="h-8 w-20">
      <ResponsiveContainer width="100%" height="100%">
        <AreaChart data={data} margin={{ top: 1, right: 0, bottom: 1, left: 0 }}>
          <defs>
            <linearGradient id="sparkGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stopColor="currentColor" stopOpacity={0.25} />
              <stop offset="100%" stopColor="currentColor" stopOpacity={0.02} />
            </linearGradient>
          </defs>
          <Area
            type="monotone"
            dataKey="value"
            stroke="currentColor"
            strokeWidth={2}
            fill="url(#sparkGrad)"
            isAnimationActive={false}
            dot={false}
            activeDot={false}
          />
        </AreaChart>
      </ResponsiveContainer>
    </div>
  );
}

export function KpiCards() {
  return (
    <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {KPI_CARDS.map((card) => {
        const Icon = card.icon;
        const TrendIcon = card.trendIcon;
        const isUp = card.trend > 0;
        const absTrend = Math.abs(card.trend);

        return (
          <div
            key={card.label}
            className={`flex gap-2 rounded-xl border-l-4 p-4 shadow-sm bg-primary ${card.borderClass}`}
          >
            <div className="flex-1">
              <Typography variant="body-2" weight="semibold">
                {card.label}
              </Typography>

              <Typography variant="body-1" weight="bold">
                {card.value}
              </Typography>
              <Typography variant="label-3">{card.comment}</Typography>
            </div>

            {/* Sparkline graph */}
            <div className="flex flex-col items-end justify-end self-end">
              <div className={`${card.textClass}`}>
                <Sparkline data={card.sparklineData} />
              </div>
              <div className="flex items-center gap-0.5 mt-0.5">
                <TrendIcon
                  className={`h-3 w-3 ${isUp ? "text-success-primary" : "text-error-primary"}`}
                />
                <span
                  className={`text-xs font-medium ${isUp ? "text-success-primary" : "text-error-primary"}`}
                >
                  {isUp ? "+" : ""}
                  {absTrend}%
                </span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  );
}
